# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/dbname

# Admin Dashboard Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123

# JWT Secret Key
JWT_SECRET=your_secret_key

# Server Port (Render will provide this automatically)
PORT=4000

# OTP.dev Credentials
OTP_DEV_API_KEY=your_api_key
OTP_DEV_TEMPLATE_ID=your_template_id
OTP_DEV_SENDER_ID=your_sender_id

# Demo OTP (Set to 1 to enable fixed code login — email + SMS)
DEMO_OTP_ENABLED=0
DEMO_OTP_CODE=123456

# Gmail SMTP only — login OTP + registration/payment emails
# App Password: https://myaccount.google.com/apppasswords
# On Render: same SMTP_* values → Save → Manual Deploy
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM=your-gmail@gmail.com

# If Gmail times out on Render, try:
# SMTP_PORT=465
# SMTP_SECURE=true

# Emails sent automatically (same SMTP):
# - Payment received (full company + payment details)
# - Tracker steps: Documents submitted, Application submitted, Process initiated, Filed with MCA, Approved
# - Reminders: payment pending / registration in progress (max once per 24h per filing)

# Production: keep DEMO_OTP_ENABLED=0 so only real emailed OTPs work
# Development only (no SMTP): DEMO_OTP_ENABLED=1 and DEMO_OTP_CODE=123456

# In-app "Update available" banner (set after each Play Store release)
APP_LATEST_VERSION=1.0.5
APP_MIN_VERSION=1.0.0
APP_LATEST_ANDROID_VERSION_CODE=6

# Razorpay (company registration checkout) — Key ID must start with rzp_test_ or rzp_live_
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_key_secret_from_dashboard

# Uptime / keep-alive (optional — Render cron uses PING_HOST/PING_PORT from render.yaml)
# PING_URL=https://your-service.onrender.com/api/health
# KEEP_ALIVE_URL=https://your-service.onrender.com/api/health
# KEEP_ALIVE_INTERVAL_MS=60000
# PING_INTERVAL_MS=60000
