# Backend API base URL. Required when running the app on a physical device.
# Use your computer's local IP and the port where the backend runs (e.g. 4000).
# Examples:
#   Android/iOS device on same WiFi:  http://192.168.1.5:4000/api
#   Leave unset for emulator/simulator (app uses 10.0.2.2:4000 on Android emulator, localhost on iOS).
EXPO_PUBLIC_API_URL=

# Optional: override booking API (defaults to same host as EXPO_PUBLIC_API_URL or localhost)
# EXPO_PUBLIC_BOOKING_API_URL=http://192.168.1.5:4000/api/bookings

# Optional: company registration / Google Sheets API
# EXPO_PUBLIC_COMPANY_REGISTRATION_API_URL=

# Google Sign-In. Required for "Continue with Google". Same as GOOGLE_CLIENT_ID in backend.
# EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Firebase (optional). If set, email/password sign-in and Firebase-verified Google sign-in are enabled.
# From Firebase Console → Project settings → General → Your apps (Web app config).
# EXPO_PUBLIC_FIREBASE_API_KEY=
# EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
# EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
# EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# EXPO_PUBLIC_FIREBASE_APP_ID=
