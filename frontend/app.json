{
  "expo": {
    "name": "finoverts",
    "slug": "finoverts",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/App logo .jpeg",
    "scheme": "finoverts",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.brandovert.finoverts",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/App logo .jpeg"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.brandovert.finoverts"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/App logo .jpeg"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/App logo .jpeg",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-web-browser",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a26a48e3-4bb8-42a0-b38f-cb24bf2198c9"
      }
    },
    "owner": "shyamhero",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a26a48e3-4bb8-42a0-b38f-cb24bf2198c9"
    }
  }
}