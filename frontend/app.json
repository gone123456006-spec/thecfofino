{
  "expo": {
    "name": "Finovert",
    "slug": "finovert",
    "version": "1.0.5",
    "orientation": "portrait",
    "icon": "./assets/images/FinoC.png",
    "splash": {
      "image": "./assets/images/FinoC.png",
      "resizeMode": "contain",
      "backgroundColor": "#e3f2fd"
    },
    "scheme": "finovert",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.brandovert.finovert",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Allow access to camera to take photos of documents.",
        "NSPhotoLibraryUsageDescription": "Allow access to gallery to upload document photos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/FinoC.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.brandovert.finovert",
      "usesCleartextTraffic": true,
      "versionCode": 6,
      "permissions": [
        "CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ],
      "targetSdkVersion": 35
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/FinoC.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#e3f2fd",
          "dark": {
            "image": "./assets/images/FinoC.png",
            "backgroundColor": "#0a1628"
          }
        }
      ],
      "expo-web-browser",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow access to gallery to upload document photos.",
          "cameraPermission": "Allow access to camera to take photos of documents.",
          "microphonePermission": false
        }
      ],
      "expo-video",
      "@react-native-google-signin/google-signin"
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c70e7d82-3e5b-428b-8ad7-75bf4fd1d064"
      }
    },
    "owner": "shyamhero",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a26a48e3-4bb8-42a0-b38f-cb24bf2198c9"
    }
  }
}